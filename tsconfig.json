{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2020"],
    "types": ["webpack-env"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "target": "ES2019",
    "module": "ESNext",
    "noUncheckedIndexedAccess": true,
    "baseUrl": "./",
    "paths": { "styles": ["./styles"] }
  },
  "include": ["src/**/*", "styles/**/*"]
}
